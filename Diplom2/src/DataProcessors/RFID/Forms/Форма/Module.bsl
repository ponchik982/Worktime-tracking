&НаКлиенте
Перем ComPort;           // Объект COM-порта для фоновой работы

&НаКлиенте
Функция ОткрытьПорт(вхКоманда1 = 0)
    
    ComPortЛокальный = Неопределено;
    
    Попытка
        // 1. Создаем COM-объект
        ComPortЛокальный = Новый COMОбъект("MSCOMMLib.MSComm");
        
        // 2. Настройки порта
        ComPortЛокальный.CommPort        = 3;           // COM3
        ComPortЛокальный.Settings        = "9600,N,8,1";
        ComPortЛокальный.Handshaking     = 0;
        ComPortЛокальный.InputMode       = 1;           // Бинарный режим
        ComPortЛокальный.RThreshold      = 1;
        ComPortЛокальный.InputLen        = 0;
        ComPortЛокальный.InBufferSize    = 1024;
        
        // 3. Открываем порт
        ComPortЛокальный.PortOpen = Истина;
        
        // 4. Отправляем команду (если нужно)
        Если вхКоманда1 <> 0 Тогда
            ComPortЛокальный.Output = Символ(вхКоманда1);
        КонецЕсли;
        
        // 5. Ждем ответ (таймаут 2 секунды)
        Таймаут = 0;
        Пока ComPortЛокальный.InBufferCount = 0 И Таймаут < 20 Цикл
            Пауза(100);
            Таймаут = Таймаут + 1;
            ОбработкаПрерыванияПользователя();
        КонецЦикла;
        
        // 6. Читаем данные
        Если ComPortЛокальный.InBufferCount > 0 Тогда
            Буфер = ComPortЛокальный.Input;
            МассивБайт = Буфер.Выгрузить();
            
            Результат = "";
            Для Каждого Байт Из МассивБайт Цикл
                Результат = Результат + Символ(Байт);
            КонецЦикла;
            
            ComPortЛокальный.PortOpen = Ложь;
            Возврат Результат;
        Иначе
            ComPortЛокальный.PortOpen = Ложь;
            Возврат "";
        КонецЕсли;
        
    Исключение
        Если ComPortЛокальный <> Неопределено И ComPortЛокальный.PortOpen Тогда
            ComPortЛокальный.PortOpen = Ложь;
        КонецЕсли;
        Возврат "Ошибка: " + ОписаниеОшибки();
    КонецПопытки;
    
КонецФункции

&НаКлиенте
Процедура Пауза(мс)
    ВремяЗавершения = ТекущаяУниверсальнаяДатаВМиллисекундах() + мс;
    Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ВремяЗавершения Цикл
        // Ожидание
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КнопкаПрочитатьНажатие(Кнопка)
    
    // Очищаем поле перед чтением
    НомерКарты = "Чтение...";
    
    // Вызываем функцию чтения порта
    Результат = ОткрытьПорт(13);  // 13 = Enter
    
    // Выводим результат в поле формы
    Если Результат <> "" И Лев(Результат, 6) <> "Ошибка" Тогда
        // Очищаем от лишних символов (оставляем только цифры и буквы)
        ОчищенныйРезультат = "";
        Для Индекс = 1 По СтрДлина(Результат) Цикл
            Символ = Сред(Результат, Индекс, 1);
            // Оставляем цифры, буквы, тире
            Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-", Символ) > 0 Тогда
                ОчищенныйРезультат = ОчищенныйРезультат + Символ;
            КонецЕсли;
        КонецЦикла;
        
        Если ОчищенныйРезультат <> "" Тогда
            НомерКарты = ОчищенныйРезультат;
            Сообщить("Считан номер: " + ОчищенныйРезультат);
        Иначе
            НомерКарты = "Номер не распознан: " + Результат;
            Сообщить("Получены сырые данные: " + Результат);
        КонецЕсли;
    Иначе
        НомерКарты = "Ошибка";
        Сообщить(Результат);
    КонецЕсли;
    
КонецПроцедуры