Процедура ОбработкаПроведения(Отказ, Режим)
    
    // Записываем движение в регистр расчёта
    Движения.ЗаработнаяПлата.Записывать = Истина;
    Движение = Движения.ЗаработнаяПлата.Добавить();
    Движение.Сторно             = Ложь;
    Движение.ВидРасчета         = ПланыВидовРасчета.Начисления.Оклад;
    Движение.ПериодДействияНачало = НачалоМесяца(Дата);
    Движение.ПериодДействияКонец = КонецМесяца(Дата);
    Движение.ПериодРегистрации  = Дата;
    Движение.Сотрудник          = Сотрудник;
    Движение.РасчетныеДанные    = Сумма;
    Движения.Записать();
    
    // Получаем данные графика
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЕСТЬNULL(ЗаработнаяПлатаДанныеГрафика.РабочийДеньПериодДействия, 0) КАК Норма,
    |    ЕСТЬNULL(ЗаработнаяПлатаДанныеГрафика.РабочийДеньФактическийПериодДействия, 0) КАК Факт,
    |    ЕСТЬNULL(ЗаработнаяПлатаДанныеГрафика.РасчетныеДанные, 0) КАК РасчетныеДанные
    |ИЗ
    |    РегистрРасчета.ЗаработнаяПлата.ДанныеГрафика(
    |        Регистратор = &Регистратор) КАК ЗаработнаяПлатаДанныеГрафика";
    
    Запрос.УстановитьПараметр("Регистратор", Ссылка);
    РезультатЗапроса = Запрос.Выполнить();
    
    Если НЕ РезультатЗапроса.Пустой() Тогда
        
        ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
        ВыборкаДетальныеЗаписи.Следующий();
        
        Норма = ?(ТипЗнч(ВыборкаДетальныеЗаписи.Норма) = Тип("Число"),
                  ВыборкаДетальныеЗаписи.Норма, 0);
        Факт  = ?(ТипЗнч(ВыборкаДетальныеЗаписи.Факт) = Тип("Число"),
                  ВыборкаДетальныеЗаписи.Факт, 0);
        РасчДанные = ?(ТипЗнч(ВыборкаДетальныеЗаписи.РасчетныеДанные) = Тип("Число"),
                       ВыборкаДетальныеЗаписи.РасчетныеДанные, Сумма);
        
        Если Норма <> 0 Тогда
            Оклад = РасчДанные * Факт / Норма;
        Иначе
            // Если норма не заполнена — берём сумму напрямую
            Оклад = Сумма;
            Сообщить("График не заполнен, оклад начислен полностью: " + Оклад);
        КонецЕсли;
        
    Иначе
        // Данных графика нет — начисляем полный оклад
        Оклад = Сумма;
        Сообщить("Данные графика отсутствуют, оклад начислен полностью: " + Оклад);
    КонецЕсли;
    
    // Записываем итоговую сумму
    Движение.Сумма = Оклад;
    Движения.ЗаработнаяПлата.Записать();
    
    // Движение в регистр долгов
    Движения.ДолгиПоЗаработнойПлате.Записывать = Истина;
    ДвижДолг             = Движения.ДолгиПоЗаработнойПлате.Добавить();
    ДвижДолг.ВидДвижения = ВидДвиженияНакопления.Приход;
    ДвижДолг.Период      = Дата;
    ДвижДолг.Сотрудник   = Сотрудник;
    ДвижДолг.Сумма       = Оклад;
    
КонецПроцедуры