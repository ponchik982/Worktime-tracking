			<dcsat:name>ДеньМесяца</dcsat:name>
			<dcsat:expression>ДеньМесяца</dcsat:expression>
		</parameter>
	</template>
	<fieldTemplate>
		<field>ВремяНаТерритории</field>
		<template>Макет1</template>
	</fieldTemplate>
	<fieldTemplate>
		<field>ДеньМесяца</field>
